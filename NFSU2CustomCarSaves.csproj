<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NFSU2CustomCarSaves</RootNamespace>
    <AssemblyName>NFSU2CustomCarSaves</AssemblyName>
    <AssemblyTitle>Custom Car Saves</AssemblyTitle>
    <Product>Custom Car Saves</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <!-- Portable layout: Assets / Data / Stock / Tools (repo folders stay as-is). -->
  <ItemGroup>
    <None Include="Wipe-All.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Tools\Wipe-All.bat</TargetPath>
    </None>
    <None Include="car-donors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Stock\car-donors.json</TargetPath>
    </None>
    <None Include="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Stock\Templates\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
    <None Include="Assets\**\*" Exclude="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
    <!-- ApplicationIcon is a separate item; still ship the file for runtime icon load. -->
    <None Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>Assets\app.ico</TargetPath>
    </None>
    <None Include="Presets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Stock\Presets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
    <None Include="DYNO SAVES\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Stock\DynoSaves\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
    <None Include="Stats\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Stock\Stats\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.41.0" />
  </ItemGroup>

</Project>
